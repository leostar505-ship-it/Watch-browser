<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Wear OS finishes the Activity on a left-edge swipe by default
         (android:windowSwipeToDismiss defaults to true on watch themes).
         That's the "page disappears" bug: the OS closes the app out from
         under us instead of the page/back logic ever running. Disabling
         it here hands swipe-to-go-back entirely to our own code in
         MainActivity, so it behaves the same as the back button. -->
    <style name="WatchBrowserTheme" parent="android:Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>

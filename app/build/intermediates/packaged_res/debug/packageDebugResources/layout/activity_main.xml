<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="32dp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Back button: bottom dead zone, unchanged from the original. -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:background="#66FFFFFF"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        android:scaleType="fitCenter"
        android:padding="3dp" />

    <!-- Refresh: left dead zone. Button view itself stays rotated 90 deg
         so its footprint runs vertically (same 64x24 pill as the back
         button, just turned sideways to fit the ~32dp side dead zone).
         The icon graphic gets its OWN extra 90 deg clockwise rotation
         via a <rotate> drawable wrapper, independent of the button's
         rotation, so the glyph reads correctly. -->
    <ImageButton
        android:id="@+id/refreshButton"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="-16dp"
        android:rotation="90"
        android:background="#66FFFFFF"
        android:src="@drawable/ic_refresh_cw90"
        android:contentDescription="Refresh"
        android:scaleType="fitCenter"
        android:padding="3dp" />

    <!-- Zoom: right dead zone, mirrored button rotation, icon rotated
         the same extra 90 deg clockwise as requested. -->
    <ImageButton
        android:id="@+id/zoomButton"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-16dp"
        android:rotation="270"
        android:background="#66FFFFFF"
        android:src="@drawable/ic_zoom_cw90"
        android:contentDescription="Zoom"
        android:scaleType="fitCenter"
        android:padding="3dp" />

    <!-- Zoom slider panel, hidden until the zoom button is tapped.
         Vertical SeekBar (rotated) sitting above the toolbar. -->
    <LinearLayout
        android:id="@+id/zoomPanel"
        android:layout_width="40dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="#99000000"
        android:gravity="center"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/zoomSeekBar"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:rotation="270"
            android:max="150"
            android:progress="78" />

    </LinearLayout>

</FrameLayout>
